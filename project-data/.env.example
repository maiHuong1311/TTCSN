# Example environment variables. PowerShell scripts do not automatically load this file.
DB_URL=jdbc:mysql://127.0.0.1:3307/fashion_store?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=fashion
DB_PASSWORD=fashion
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
FRONTEND_ORIGIN=http://127.0.0.1:5173
JWT_SECRET=local-development-secret-change-before-production-2026
SPRING_PROFILES_ACTIVE=local
LOCAL_ADMIN_EMAIL=admin@forme.local
LOCAL_ADMIN_PASSWORD=FormeLocalAdmin2026!
AI_API_URL=
AI_API_KEY=
AI_CONNECT_TIMEOUT_SECONDS=1
AI_READ_TIMEOUT_SECONDS=2
# Brevo SMTP (SMTP password is an SMTP key; keep personal values out of source).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# Optional: absolute directory for uploaded product images. Default: backend/uploads/product-images
PRODUCT_IMAGES_DIRECTORY=./uploads/product-images
